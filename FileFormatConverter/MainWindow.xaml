<Window x:Class="FileFormatConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Converter" Height="350" Width="500"
        AllowDrop="True"
        Drop="Window_Drop">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderThickness="2" BorderBrush="Gray" CornerRadius="10">
            <TextBlock Text="Перетащи файл сюда"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="20"/>
        </Border>

        <ComboBox x:Name="FormatBox"
                  Grid.Row="1"
                  Margin="0,15,0,0">
            <ComboBoxItem Content="TXT → PDF"/>
            <ComboBoxItem Content="PNG → JPG"/>
        </ComboBox>

        <Button Grid.Row="2"
                Content="Convert"
                Margin="0,10,0,0"
                Height="35"
                Click="Convert_Click"/>
    </Grid>
</Window>
